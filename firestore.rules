rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "faisal.ab4303@gmail.com" ||
        request.auth.token.email.lower() == "faisal.ab43035@gmail.com" ||
        request.auth.token.email.lower() == "admin@ugcbncc.org"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Global collection rules for application collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

